{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "outcome", "summary", "candidates"],
  "properties": {
    "batch_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outcome": {"type": "string", "enum": ["reviewed", "no_change"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "candidates": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_event_ids", "problem", "proposed_change", "target", "patch", "checks", "expected_behavior", "confidence"],
        "properties": {
          "evidence_event_ids": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
          "problem": {"type": "string", "minLength": 1, "maxLength": 4000},
          "proposed_change": {"type": "string", "minLength": 1, "maxLength": 4000},
          "target": {"type": "string", "minLength": 1, "maxLength": 512},
          "patch": {"type": ["string", "null"], "maxLength": 32000},
          "checks": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "enum": ["markdown", "frontmatter"]}},
          "expected_behavior": {"type": "string", "minLength": 1, "maxLength": 4000},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
        }
      }
    }
  }
}
