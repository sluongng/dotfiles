[database]
mail_root=/home/USER/.local/share/mail/personal
path=/home/USER/.local/share/notmuch/personal

[user]
name=Your Name
primary_email=personal@example.com
other_email=

[new]
tags=unread;inbox;
ignore=.mbsyncstate;.mbsyncstate.journal;.uidvalidity

[search]
exclude_tags=deleted;spam;

[maildir]
synchronize_flags=true

[index]
decrypt=auto
