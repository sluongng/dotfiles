#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
remote_name="${1:-origin}"
zero_oid="0000000000000000000000000000000000000000"
revisions=()

while read -r _local_ref local_oid _remote_ref remote_oid; do
  if [ "${local_oid}" = "${zero_oid}" ]; then
    continue
  fi
  if [ "${remote_oid}" != "${zero_oid}" ]; then
    revisions+=("${remote_oid}..${local_oid}")
    continue
  fi

  revisions+=("${local_oid}")
  while read -r remote_tip; do
    revisions+=("^${remote_tip}")
  done < <(
    git for-each-ref --format='%(objectname)' "refs/remotes/${remote_name}/"
  )
done

if [ "${#revisions[@]}" -gt 0 ]; then
  exec python3 "${repo_root}/automation/codex/check-config-privacy.py" \
    --history "${revisions[@]}"
fi
